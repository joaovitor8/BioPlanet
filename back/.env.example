# Copie este arquivo para .env e ajuste.

# Postgres local (docker compose up -d) — usuário, senha e banco "bioplanet"
DATABASE_URL=postgres://bioplanet:bioplanet@localhost:5432/bioplanet

# Supabase/Neon: cole a connection string deles e ligue o SSL
# DATABASE_URL=postgres://usuario:senha@host:5432/postgres
# DATABASE_SSL=true

PORT=3001
WEB_URL=http://localhost:3000
